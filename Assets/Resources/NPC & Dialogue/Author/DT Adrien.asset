  npcLine:
  - key: 
    pl: "Tak. Ucz\u0119szczam do szko\u0142y"
    en: 
    de: 
  - key: 
    pl: "Na szcz\u0119\u015Bcie ju\u017C ostatni rok"
    en: 
    de: 
  - key: 
    pl: "Nie przepadam za chodzeniem do szko\u0142y"
    en: 
    de: 
  - key: 
    pl: "Nie lubie tam marnowa\u0107 czasu. W domu mam tyle rzeczy do roobty zawsze"
    en: 
    de: 
  - key: 
    pl: "Nigdy nie mia\u0142em problem\xF3w z r\xF3wnie\u015Bnikami a wi\u0119c jako\u015B
      ten czas zlatywa\u0142"
    en: 
    de: 
  options:
  - playerLine:
      key: 
      pl: "Nauka jest wa\u017Cne"
      en: 
      de: 
    typeInteraction: 0
